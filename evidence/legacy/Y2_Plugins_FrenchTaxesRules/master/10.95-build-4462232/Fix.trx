16:21:37.7841200+02:00: root Information: 0 : Cegid.Framework.Data | SqlService | [PGI] SELECT GP_NATUREPIECEG,GP_SOUCHE,GP_NUMERO,GP_INDICEG, GL_NUMLIGNE,GL_ARTICLE,GL_LIBELLE,GA_CODEBARRE,GL_QTEFACT,GL_FAMILLETAXE1,GL_FAMILLETAXE2,GL_PUHTDEV,GL_PUHTBASE,GL_PUTTCDEV,GL_TOTALHTDEV,GL_TOTALTTCDEV,GL_TOTALTAXE1,GL_TOTALTAXE2,GL_QTEFACT,GL_QUALIFQTEVTE,GL_REMISELIGNE,GL_CREATEUR,GL_CAISSE,GL_REPRESENTANT,GL_DATECREATION,GL_CREERPAR,GL_TYPELIGNE,GL_TYPEARTICLE,MLR_ORGREMISE,
                                b1.GPB_TAUXTAXE AS GPB_TAUXTAXE1, b2.GPB_TAUXTAXE AS GPB_TAUXTAXE2, 
                                CC_LIBELLE
                        FROM PIECE
                        JOIN LIGNE ON GL_NATUREPIECEG = GP_NATUREPIECEG AND GL_SOUCHE = GP_SOUCHE AND GL_NUMERO = GP_NUMERO AND GL_INDICEG = GP_INDICEG
                        LEFT JOIN ( SELECT GPB_NATUREPIECEG, GPB_SOUCHE, GPB_NUMERO, GPB_INDICEG, GPB_CATEGORIETAXE, MAX(GPB_TAUXTAXE) AS GPB_TAUXTAXE 
			                        FROM PIEDBASE 
                                    GROUP BY GPB_NATUREPIECEG, GPB_SOUCHE, GPB_NUMERO, GPB_INDICEG, GPB_CATEGORIETAXE, GPB_FAMILLETAXE ) as b1 
			                        ON b1.GPB_NATUREPIECEG = GL_NATUREPIECEG AND b1.GPB_SOUCHE = GL_SOUCHE AND b1.GPB_NUMERO = GL_NUMERO AND b1.GPB_INDICEG = GL_INDICEG AND b1.GPB_CATEGORIETAXE = TRIM(GL_CODEMODELETAXE) + '1'
                        LEFT JOIN ( SELECT GPB_NATUREPIECEG, GPB_SOUCHE, GPB_NUMERO, GPB_INDICEG, GPB_CATEGORIETAXE, MAX(GPB_TAUXTAXE) AS GPB_TAUXTAXE 
			                        FROM PIEDBASE 
                                    GROUP BY GPB_NATUREPIECEG, GPB_SOUCHE, GPB_NUMERO, GPB_INDICEG, GPB_CATEGORIETAXE, GPB_FAMILLETAXE ) as b2 
			                        ON b2.GPB_NATUREPIECEG = GL_NATUREPIECEG AND b2.GPB_SOUCHE = GL_SOUCHE AND b2.GPB_NUMERO = GL_NUMERO AND b2.GPB_INDICEG = GL_INDICEG AND b2.GPB_CATEGORIETAXE = TRIM(GL_CODEMODELETAXE) + '2'
                        LEFT JOIN LIGNEREMISE ON MLR_NATUREPIECEG = GL_NATUREPIECEG AND MLR_SOUCHE = GL_SOUCHE AND MLR_NUMERO = GL_NUMERO AND MLR_INDICEG = GL_INDICEG AND MLR_NUMLIGNE = GL_NUMLIGNE
                        LEFT JOIN ARTICLE on GA_ARTICLE = GL_ARTICLE
                        LEFT JOIN CHOIXCOD on CC_CODE = GL_FAMILLETAXE1 AND CC_TYPE = 'TX1'
                        WHERE GP_NATUREPIECEG = @param1 
                            AND GP_ETABLISSEMENT = @param2
                            AND GP_DTSVCREATE &gt;= @param3 AND GP_DTSVCREATE &lt; @param4
                            AND GP_TYPECOMPTA = @param0
                        ORDER BY GL_NATUREPIECEG, GL_SOUCHE, GL_NUMERO, GL_INDICEG, GL_NUMLIGNE
16:21:37.7841200+02:00: root Verbose: 0 : Cegid.Framework.Data | SqlService | [NATIVE] SELECT PIECE.GP_NATUREPIECEG, PIECE.GP_SOUCHE, PIECE.GP_NUMERO, PIECE.GP_INDICEG, LIGNE.GL_NUMLIGNE, LIGNE.GL_ARTICLE, LIGNE.GL_LIBELLE, ARTICLE.GA_CODEBARRE, LIGNE.GL_QTEFACT, LIGNE.GL_FAMILLETAXE1, LIGNE.GL_FAMILLETAXE2, LIGNE.GL_PUHTDEV, LIGNE.GL_PUHTBASE, LIGNE.GL_PUTTCDEV, LIGNE.GL_TOTALHTDEV, LIGNE.GL_TOTALTTCDEV, LIGNE.GL_TOTALTAXE1, LIGNE.GL_TOTALTAXE2, LIGNE.GL_QTEFACT, LIGNE.GL_QUALIFQTEVTE, LIGNE.GL_REMISELIGNE, LIGNE.GL_CREATEUR, LIGNE.GL_CAISSE, LIGNE.GL_REPRESENTANT, LIGNE.GL_DATECREATION, LIGNE.GL_CREERPAR, LIGNE.GL_TYPELIGNE, LIGNE.GL_TYPEARTICLE, LIGNEREMISE.MLR_ORGREMISE, b1.GPB_TAUXTAXE AS GPB_TAUXTAXE1, b2.GPB_TAUXTAXE AS GPB_TAUXTAXE2, CHOIXCOD.CC_LIBELLE FROM PIECE JOIN LIGNE ON LIGNE.GL_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND LIGNE.GL_SOUCHE = PIECE.GP_SOUCHE AND LIGNE.GL_NUMERO = PIECE.GP_NUMERO AND LIGNE.GL_INDICEG = PIECE.GP_INDICEG LEFT JOIN (SELECT PIEDBASE.GPB_NATUREPIECEG, PIEDBASE.GPB_SOUCHE, PIEDBASE.GPB_NUMERO, PIEDBASE.GPB_INDICEG, PIEDBASE.GPB_CATEGORIETAXE, MAX(PIEDBASE.GPB_TAUXTAXE) AS GPB_TAUXTAXE FROM PIEDBASE GROUP BY PIEDBASE.GPB_NATUREPIECEG, PIEDBASE.GPB_SOUCHE, PIEDBASE.GPB_NUMERO, PIEDBASE.GPB_INDICEG, PIEDBASE.GPB_CATEGORIETAXE, PIEDBASE.GPB_FAMILLETAXE ) AS b1 ON b1.GPB_NATUREPIECEG = LIGNE.GL_NATUREPIECEG AND b1.GPB_SOUCHE = LIGNE.GL_SOUCHE AND b1.GPB_NUMERO = LIGNE.GL_NUMERO AND b1.GPB_INDICEG = LIGNE.GL_INDICEG AND b1.GPB_CATEGORIETAXE = RTRIM(LTRIM(LIGNE.GL_CODEMODELETAXE)) + '1' LEFT JOIN (SELECT PIEDBASE.GPB_NATUREPIECEG, PIEDBASE.GPB_SOUCHE, PIEDBASE.GPB_NUMERO, PIEDBASE.GPB_INDICEG, PIEDBASE.GPB_CATEGORIETAXE, MAX(PIEDBASE.GPB_TAUXTAXE) AS GPB_TAUXTAXE FROM PIEDBASE GROUP BY PIEDBASE.GPB_NATUREPIECEG, PIEDBASE.GPB_SOUCHE, PIEDBASE.GPB_NUMERO, PIEDBASE.GPB_INDICEG, PIEDBASE.GPB_CATEGORIETAXE, PIEDBASE.GPB_FAMILLETAXE ) AS b2 ON b2.GPB_NATUREPIECEG = LIGNE.GL_NATUREPIECEG AND b2.GPB_SOUCHE = LIGNE.GL_SOUCHE AND b2.GPB_NUMERO = LIGNE.GL_NUMERO AND b2.GPB_INDICEG = LIGNE.GL_INDICEG AND b2.GPB_CATEGORIETAXE = RTRIM(LTRIM(LIGNE.GL_CODEMODELETAXE)) + '2' LEFT JOIN LIGNEREMISE ON LIGNEREMISE.MLR_NATUREPIECEG = LIGNE.GL_NATUREPIECEG AND LIGNEREMISE.MLR_SOUCHE = LIGNE.GL_SOUCHE AND LIGNEREMISE.MLR_NUMERO = LIGNE.GL_NUMERO AND LIGNEREMISE.MLR_INDICEG = LIGNE.GL_INDICEG AND LIGNEREMISE.MLR_NUMLIGNE = LIGNE.GL_NUMLIGNE LEFT JOIN ARTICLE ON ARTICLE.GA_ARTICLE = LIGNE.GL_ARTICLE LEFT JOIN CHOIXCOD ON CHOIXCOD.CC_CODE = LIGNE.GL_FAMILLETAXE1 AND CHOIXCOD.CC_TYPE = 'TX1' WHERE PIECE.GP_NATUREPIECEG = @param1 AND PIECE.GP_ETABLISSEMENT = @param2 AND PIECE.GP_DTSVCREATE &gt;= @param3 AND PIECE.GP_DTSVCREATE &lt; @param4 AND PIECE.GP_TYPECOMPTA = @param0  ORDER BY GL_NATUREPIECEG, GL_SOUCHE, GL_NUMERO, GL_INDICEG, GL_NUMLIGNE 
