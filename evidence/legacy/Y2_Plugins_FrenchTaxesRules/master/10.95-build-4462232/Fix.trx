16:21:35.5971279+02:00: root Information: 0 : Cegid.Framework.Data | SqlService | [PGI] UPDATE JOURNALEVENT SET GHE_BLOCNOTES = 
    CASE 
        WHEN GHE_BLOCNOTES IS NULL OR LEN(CAST(GHE_BLOCNOTES AS VARCHAR(1))) = 0
            THEN @p0
        ELSE CAST(GHE_BLOCNOTES AS VARCHAR) + CHAR(13) + CHAR(10) + @p1
