_CODEMODELETAXE)) + '1' LEFT JOIN PIECEADRESSE AS ADRESSE ON ADRESSE.GPA_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND ADRESSE.GPA_SOUCHE = PIECE.GP_SOUCHE AND ADRESSE.GPA_NUMERO = PIECE.GP_NUMERO AND ADRESSE.GPA_INDICEG = PIECE.GP_INDICEG AND ADRESSE.GPA_TYPEPIECEADR = (SELECT MAX(A2.GPA_TYPEPIECEADR) FROM PIECEADRESSE AS A2 WHERE A2.GPA_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND A2.GPA_SOUCHE = PIECE.GP_SOUCHE AND A2.GPA_NUMERO = PIECE.GP_NUMERO AND A2.GPA_INDICEG = PIECE.GP_INDICEG ) LEFT JOIN SIGNLINK AS s1 ON s1.SIL_RANG = 'D' AND s1.SIL_ETABLISSEMENT = PIECE.GP_ETABLISSEMENT AND s1.SIL_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND s1.SIL_SOUCHE = PIECE.GP_SOUCHE AND s1.SIL_NUMERO = PIECE.GP_NUMERO AND s1.SIL_INDICEG = PIECE.GP_INDICEG LEFT JOIN SIGNLINK AS s2 ON s2.SIL_LINKID = s1.SIL_LINKID AND s2.SIL_RANG = 'O' LEFT JOIN MPIECECOMPL AS m2 ON m2.MDI_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND m2.MDI_SOUCHE = s2.SIL_SOUCHE AND m2.MDI_NUMERO = s2.SIL_NUMERO AND m2.MDI_TYPEFISCAL IN (@param0, @param1 ) WHERE PIECE.GP_NATUREPIECEG = @param5 AND PIECE.GP_ETABLISSEMENT = @param6 AND PIECE.GP_DTSVCREATE BETWEEN @param7 AND @param8 AND (PIECE.GP_CAISSE NOT IN (SELECT PARCAISSE.GPK_CAISSE FROM PARCAISSE WHERE PARCAISSE.GPK_TYPEMOBILITE IN (@param9, @param10, @param11 ) AND PARCAISSE.GPK_ETABLISSEMENT = @param6 ) OR PIECE.GP_CAISSE = '' OR PIECE.GP_CAISSE IS NULL) AND PIECE.GP_TYPECOMPTA = @param0  ORDER BY s1.SIL_DATECREATION, s1.SIL_ORDER, GPB_NUMLIGNE 
