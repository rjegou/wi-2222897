                        lEFT JOIN SIGNLINK AS s2 ON s2.SIL_LINKID = s1.SIL_LINKID AND s2.SIL_RANG = 'O'
                        LEFT JOIN MPIECECOMPL AS m2 ON m2.MDI_NATUREPIECEG = GP_NATUREPIECEG AND m2.MDI_SOUCHE = s2.SIL_SOUCHE AND m2.MDI_NUMERO = s2.SIL_NUMERO AND m2.MDI_TYPEFISCAL IN (@param0,@param1)
