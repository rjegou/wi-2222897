XE)) + '1' LEFT JOIN PIECEADRESSE AS ADRESSE ON ADRESSE.GPA_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND ADRESSE.GPA_SOUCHE = PIECE.GP_SOUCHE AND ADRESSE.GPA_NUMERO = PIECE.GP_NUMERO AND ADRESSE.GPA_INDICEG = PIECE.GP_INDICEG AND ADRESSE.GPA_TYPEPIECEADR = (SELECT MAX(A2.GPA_TYPEPIECEADR) FROM PIECEADRESSE AS A2 WHERE A2.GPA_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND A2.GPA_SOUCHE = PIECE.GP_SOUCHE AND A2.GPA_NUMERO = PIECE.GP_NUMERO AND A2.GPA_INDICEG = PIECE.GP_INDICEG ) WHERE PIECE.GP_NATUREPIECEG = @param6 AND PIECE.GP_ETABLISSEMENT = @param7 AND PIECE.GP_DTSVCREATE BETWEEN @param8 AND @param9 AND PIECE.GP_CAISSE IN (SELECT PARCAISSE.GPK_CAISSE FROM PARCAISSE WHERE PARCAISSE.GPK_TYPEMOBILITE IN (@param10, @param11, @param12 ) AND PARCAISSE.GPK_ETABLISSEMENT = @param7 ) AND PIECE.GP_TYPECOMPTA != @param0  ORDER BY GP_CAISSE, MDI_REFFISCALEVAL, GPB_NUMLIGNE 
