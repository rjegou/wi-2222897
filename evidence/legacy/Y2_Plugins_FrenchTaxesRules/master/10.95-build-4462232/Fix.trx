16:21:52.5883167+02:00: root Information: 0 : Cegid.Framework.Data | SqlService | [PGI] SELECT c.MNG_CLOID, c.MNG_DAEMONID, c.MNG_CAISSE, DAE_ETABLISS, c.MNG_LEVEL, c.MNG_CLOTYPE, 
                c.MNG_TARGETDATE, c.MNG_DATEEXEC, c.MNG_TOTALHT, c.MNG_TOTALTTC, c.MNG_TOTALHTPERP, c.MNG_TOTALTTCPERP, c.MNG_DEVISE, 
                c.MNG_CLOIDPREC, prev.MNG_TOTALTTCPERP as TOTALTTCPERPPREC, prev.MNG_CLOSINGSIGN as CLOSINGSIGNPREC,
                c.MNG_CLOSINGSIGN, DAE_SIGNVERSION, CKY_SIGNKEYVERSION, CKY_CUSTOMERKEY,
                CTA_CLOID, CTA_TAUXTAXE, CTA_BASETAXE, CTA_VALEURTAXE, CTA_DEVISE 
                FROM CLOSING c
                LEFT JOIN DAEMON            ON DAE_DAEMONID       = c.MNG_DAEMONID 
                LEFT JOIN CLOSINGTAX        ON CTA_CLOID          = c.MNG_CLOID
                LEFT JOIN CLOSING prev      ON prev.MNG_CLOID     = c.MNG_CLOIDPREC
                LEFT JOIN CUSTOMERKEY       ON CKY_SIGNKEYVERSION = DAE_SIGNKEYVERSION
                WHERE DAE_ETABLISS in (@param1)
                  AND DAE_SIGNVERSION &gt;= @param2
                  AND c.MNG_TARGETDATE = @param0
                ORDER BY c.MNG_CLOID, CTA_TAUXTAXE, CTA_DEVISE
16:21:52.5883167+02:00: root Verbose: 0 : Cegid.Framework.Data | SqlService | [NATIVE] SELECT c.MNG_CLOID, c.MNG_DAEMONID, c.MNG_CAISSE, DAEMON.DAE_ETABLISS, c.MNG_LEVEL, c.MNG_CLOTYPE, c.MNG_TARGETDATE, c.MNG_DATEEXEC, c.MNG_TOTALHT, c.MNG_TOTALTTC, c.MNG_TOTALHTPERP, c.MNG_TOTALTTCPERP, c.MNG_DEVISE, c.MNG_CLOIDPREC, prev.MNG_TOTALTTCPERP AS TOTALTTCPERPPREC, prev.MNG_CLOSINGSIGN AS CLOSINGSIGNPREC, c.MNG_CLOSINGSIGN, DAEMON.DAE_SIGNVERSION, CUSTOMERKEY.CKY_SIGNKEYVERSION, CUSTOMERKEY.CKY_CUSTOMERKEY, CLOSINGTAX.CTA_CLOID, CLOSINGTAX.CTA_TAUXTAXE, CLOSINGTAX.CTA_BASETAXE, CLOSINGTAX.CTA_VALEURTAXE, CLOSINGTAX.CTA_DEVISE FROM CLOSING AS c LEFT JOIN DAEMON ON DAEMON.DAE_DAEMONID = c.MNG_DAEMONID LEFT JOIN CLOSINGTAX ON CLOSINGTAX.CTA_CLOID = c.MNG_CLOID LEFT JOIN CLOSING AS prev ON prev.MNG_CLOID = c.MNG_CLOIDPREC LEFT JOIN CUSTOMERKEY ON CUSTOMERKEY.CKY_SIGNKEYVERSION = DAEMON.DAE_SIGNKEYVERSION WHERE DAEMON.DAE_ETABLISS IN (@param1 ) AND DAEMON.DAE_SIGNVERSION &gt;= @param2 AND c.MNG_TARGETDATE = @param0  ORDER BY c.MNG_CLOID, CTA_TAUXTAXE, CTA_DEVISE 
