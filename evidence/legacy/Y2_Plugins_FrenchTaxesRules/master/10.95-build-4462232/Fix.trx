16:19:52.7771069+02:00: root Information: 0 : Cegid.Framework.Data | SqlService | [PGI] SELECT TOP 1 SIL_NATUREPIECEG, SIL_SOUCHE, SIL_NUMERO, SIL_ORDER, SIL_INDICEG, MDI_REFFISCALESIGN
                        FROM MPIECECOMPL
                        lEFT JOIN SIGNLINK ON SIL_RANG = 'D' AND SIL_NATUREPIECEG = MDI_NATUREPIECEG AND SIL_SOUCHE = MDI_SOUCHE AND SIL_NUMERO = MDI_NUMERO
                        WHERE SIL_ETABLISSEMENT = @param0
                          AND SIL_NATUREPIECEG = @param1 
                          AND SIL_SOUCHE = @param0
                          AND SIL_TYPE = @param2 
