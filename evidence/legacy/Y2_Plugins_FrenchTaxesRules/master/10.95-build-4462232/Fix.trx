        WHEN GHE_BLOCNOTES IS NULL OR LEN(CAST(GHE_BLOCNOTES AS VARCHAR(1))) = 0
            THEN @p0
        ELSE CAST(GHE_BLOCNOTES AS VARCHAR) + CHAR(13) + CHAR(10) + @p1
    END , GHE_STATUTEVENT = @p2 , GHE_DATEMODIF = @p3 , GHE_UTILISATEUR = @p4 WHERE GHE_NUMERO = @p5 AND GHE_CODESITE = @p6
