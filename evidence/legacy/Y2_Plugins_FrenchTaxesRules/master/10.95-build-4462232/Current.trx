16:28:14.9581763+02:00: root Information: 0 : Cegid.Framework.Data | SqlService | [PGI] SELECT GHE_CODESITE,GHE_NUMERO,GHE_NIVEAU3,GHE_RESUME,GHE_DATECREATION,GHE_UTILISATEUR,GHE_CODESITE,GHS_EVENTSIGN,GHS_SIGNVERSION,CKY_SIGNKEYVERSION,CKY_CUSTOMERKEY, CO_LIBELLE
                            FROM JOURNALEVENT
                            LEFT JOIN JOURNALEVENTSIGN ON GHS_ETABLISSEMENT = GHE_CODESITE AND GHS_NUMERO = GHE_NUMERO
                            LEFT JOIN CUSTOMERKEY ON CKY_SIGNKEYVERSION = GHS_SIGNKEYVERSION
                            LEFT JOIN COMMUN ON CO_CODE = GHE_NIVEAU3 AND CO_TYPE = 'GJ3' 
                            WHERE GHE_CODESITE = @param0
                                  AND GHE_DATECREATION BETWEEN @param1 AND @param2
                                  AND GHE_NIVEAU3 IN ('CAI','EJ1','EJ2','EN0','EN2','EN4','EN5','EN6','ENB','JO1','OF4','OF5','OF6','OF7','P01','RE2','SO3','TM2','TM3','UT1','W01','W02','W03','W04','W05','W06','W07','W08','W09','W10','W11','W12','W13','W14','W15','W16','W17')
                            ORDER BY GHE_NUMERO
