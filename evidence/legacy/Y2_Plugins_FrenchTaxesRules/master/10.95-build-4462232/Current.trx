                c.MNG_TARGETDATE, c.MNG_DATEEXEC, c.MNG_TOTALHT, c.MNG_TOTALTTC, c.MNG_TOTALHTPERP, c.MNG_TOTALTTCPERP, c.MNG_DEVISE, 
                c.MNG_CLOIDPREC, prev.MNG_TOTALTTCPERP as TOTALTTCPERPPREC, prev.MNG_CLOSINGSIGN as CLOSINGSIGNPREC,
                c.MNG_CLOSINGSIGN, DAE_SIGNVERSION, CKY_SIGNKEYVERSION, CKY_CUSTOMERKEY,
                CTA_CLOID, CTA_TAUXTAXE, CTA_BASETAXE, CTA_VALEURTAXE, CTA_DEVISE 
                FROM CLOSING c
                LEFT JOIN DAEMON            ON DAE_DAEMONID       = c.MNG_DAEMONID 
                LEFT JOIN CLOSINGTAX        ON CTA_CLOID          = c.MNG_CLOID
                LEFT JOIN CLOSING prev      ON prev.MNG_CLOID     = c.MNG_CLOIDPREC
                LEFT JOIN CUSTOMERKEY       ON CKY_SIGNKEYVERSION = DAE_SIGNKEYVERSION
                WHERE DAE_ETABLISS in (@param2)
                  AND DAE_SIGNVERSION &gt;= @param3
