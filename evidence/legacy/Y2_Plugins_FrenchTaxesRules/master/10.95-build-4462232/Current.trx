16:26:07.7075331+02:00: root Verbose: 0 : Cegid.Erp.Data | EFProvider | Génération terminée
16:26:07.7075331+02:00: root Information: 0 : Cegid.Erp.Data | EFProvider | [NATIVE] : SELECT [Project2].[C1] AS [C1], [Project2].[OBJECTKIND] AS [OBJECTKIND], [Project2].[C2] AS [C2], [Project2].[OBJECTNAME] AS [OBJECTNAME], [Project2].[OBJECTKIND1] AS [OBJECTKIND1], [Project2].[TARGETDATABASE] AS [TARGETDATABASE] FROM (SELECT [Distinct1].[OBJECTKIND] AS [OBJECTKIND], 1 AS [C1], [Extent2].[OBJECTNAME] AS [OBJECTNAME], [Extent2].[OBJECTKIND] AS [OBJECTKIND1], [Extent2].[TARGETDATABASE] AS [TARGETDATABASE], CASE WHEN [Extent2].[OBJECTNAME] IS NULL THEN CAST(NULL AS INT) ELSE 1 END AS [C2] FROM (SELECT DISTINCT [Extent1].[OBJECTKIND] AS [OBJECTKIND] FROM (SELECT [DS_NOMTABLE] AS [OBJECTNAME], COALESCE([SUBTYPE], [DS_TYPTABLE] ) AS [OBJECTKIND], [DS_NOMBASE] AS [TARGETDATABASE] FROM [DESHARE] LEFT OUTER JOIN (SELECT [DV_NOMVUE] AS [NAME], 'VUE' AS [SUBTYPE] FROM [DEVUES] ) AS [TABS] ON [DS_TYPTABLE] = 'TAB' AND [DS_NOMTABLE] = [NAME] ) AS [Extent1] WHERE NOT ([Extent1].[TARGETDATABASE] = @p__linq__0) ) AS [Distinct1] LEFT OUTER JOIN (SELECT [DS_NOMTABLE] AS [OBJECTNAME], COALESCE([SUBTYPE], [DS_TYPTABLE] ) AS [OBJECTKIND], [DS_NOMBASE] AS [TARGETDATABASE] FROM [DESHARE] LEFT OUTER JOIN (SELECT [DV_NOMVUE] AS [NAME], 'VUE' AS [SUBTYPE] FROM [DEVUES] ) AS [TABS] ON [DS_TYPTABLE] = 'TAB' AND [DS_NOMTABLE] = [NAME] ) AS [Extent2] ON (NOT ([Extent2].[TARGETDATABASE] = @p__linq__0)) AND ([Distinct1].[OBJECTKIND] = [Extent2].[OBJECTKIND]) ) AS [Project2]  ORDER BY [Project2].[OBJECTKIND], [Project2].[C2] 
