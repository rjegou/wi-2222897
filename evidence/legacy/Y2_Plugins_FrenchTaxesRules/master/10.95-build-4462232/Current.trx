                LEFT JOIN DAEMON    ON DAE_DAEMONID = MNG_DAEMONID
                LEFT JOIN PARCAISSE ON GPK_CAISSE   = MNG_CAISSE WHERE C.MNG_CLOTYPE = 'DAY' AND C.MNG_LEVEL = 'REG' AND DAE_ETABLISS = @param0 AND DAE_SIGNVERSION &gt;= @param1 AND C.MNG_TARGETDATE = (SELECT MAX(MNG_TARGETDATE) 
                                          FROM CLOSING C2 
                                          WHERE C2.MNG_CAISSE  = C.MNG_CAISSE AND C2.MNG_CLOTYPE = 'DAY' AND C2.MNG_LEVEL = 'REG')
