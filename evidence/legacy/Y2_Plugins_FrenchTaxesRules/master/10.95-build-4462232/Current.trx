                            LEFT JOIN PARCAISSE ON ET_ETABLISSEMENT = GPK_ETABLISSEMENT
                            WHERE PY_LOCALIS = 'FRA' AND (PY_CODEISO2 = 'FR' OR PY_CODEINSEE = 'FRA' OR PY_CODEBANCAIRE = '250' OR PY_LIBELLE = 'FRANCE')
