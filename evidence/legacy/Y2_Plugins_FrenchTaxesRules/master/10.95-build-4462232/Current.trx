                                b1.GPB_TAUXTAXE AS GPB_TAUXTAXE1, b2.GPB_TAUXTAXE AS GPB_TAUXTAXE2, 
                                CC_LIBELLE
                        FROM PIECE
                        JOIN LIGNE ON GL_NATUREPIECEG = GP_NATUREPIECEG AND GL_SOUCHE = GP_SOUCHE AND GL_NUMERO = GP_NUMERO AND GL_INDICEG = GP_INDICEG
                        LEFT JOIN ( SELECT GPB_NATUREPIECEG, GPB_SOUCHE, GPB_NUMERO, GPB_INDICEG, GPB_CATEGORIETAXE, MAX(GPB_TAUXTAXE) AS GPB_TAUXTAXE 
			                        FROM PIEDBASE 
                                    GROUP BY GPB_NATUREPIECEG, GPB_SOUCHE, GPB_NUMERO, GPB_INDICEG, GPB_CATEGORIETAXE, GPB_FAMILLETAXE ) as b1 
			                        ON b1.GPB_NATUREPIECEG = GL_NATUREPIECEG AND b1.GPB_SOUCHE = GL_SOUCHE AND b1.GPB_NUMERO = GL_NUMERO AND b1.GPB_INDICEG = GL_INDICEG AND b1.GPB_CATEGORIETAXE = TRIM(GL_CODEMODELETAXE) + '1'
                        LEFT JOIN ( SELECT GPB_NATUREPIECEG, GPB_SOUCHE, GPB_NUMERO, GPB_INDICEG, GPB_CATEGORIETAXE, MAX(GPB_TAUXTAXE) AS GPB_TAUXTAXE 
			                        FROM PIEDBASE 
                                    GROUP BY GPB_NATUREPIECEG, GPB_SOUCHE, GPB_NUMERO, GPB_INDICEG, GPB_CATEGORIETAXE, GPB_FAMILLETAXE ) as b2 
			                        ON b2.GPB_NATUREPIECEG = GL_NATUREPIECEG AND b2.GPB_SOUCHE = GL_SOUCHE AND b2.GPB_NUMERO = GL_NUMERO AND b2.GPB_INDICEG = GL_INDICEG AND b2.GPB_CATEGORIETAXE = TRIM(GL_CODEMODELETAXE) + '2'
                        LEFT JOIN LIGNEREMISE ON MLR_NATUREPIECEG = GL_NATUREPIECEG AND MLR_SOUCHE = GL_SOUCHE AND MLR_NUMERO = GL_NUMERO AND MLR_INDICEG = GL_INDICEG AND MLR_NUMLIGNE = GL_NUMLIGNE
                        LEFT JOIN ARTICLE on GA_ARTICLE = GL_ARTICLE
                        LEFT JOIN CHOIXCOD on CC_CODE = GL_FAMILLETAXE1 AND CC_TYPE = 'TX1'
                        WHERE GP_NATUREPIECEG = @param1 
                            AND GP_ETABLISSEMENT = @param2
                            AND GP_DTSVCREATE &gt;= @param3 AND GP_DTSVCREATE &lt; @param4
                            AND GP_TYPECOMPTA = @param0
                        ORDER BY GL_NATUREPIECEG, GL_SOUCHE, GL_NUMERO, GL_INDICEG, GL_NUMLIGNE
