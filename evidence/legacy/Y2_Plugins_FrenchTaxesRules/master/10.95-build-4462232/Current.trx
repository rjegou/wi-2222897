16:28:15.3046156+02:00: root Information: 0 : Cegid.Framework.Data | SqlService | [PGI] SELECT ISNULL(GPB_TAUXTAXE, 0) AS GPB_TAUXTAXE, SUM(ISNULL(GPB_BASEDEV, 0)) AS GPB_BASEDEV, SUM(ISNULL(GPB_VALEURDEV, 0)) AS GPB_VALEURDEV, ISNULL(GPB_DEVISE, GP_DEVISE) AS GPB_DEVISE
                    FROM PIECE
                        LEFT JOIN MPIECECOMPL ON MDI_NATUREPIECEG = GP_NATUREPIECEG AND MDI_SOUCHE = GP_SOUCHE AND MDI_NUMERO = GP_NUMERO
                                                    AND MDI_TYPEFISCAL IN (@param0,@param1,@param2,@param3)
                        LEFT JOIN PIEDBASE ON GPB_NATUREPIECEG = GP_NATUREPIECEG AND GPB_SOUCHE = GP_SOUCHE AND GPB_NUMERO = GP_NUMERO AND GPB_CATEGORIETAXE = TRIM(GP_CODEMODELETAXE) + '1'
                    WHERE GP_NATUREPIECEG=@param4
                        AND GP_ETABLISSEMENT=@param5
                        AND GP_CAISSE = @param6
                        AND (GP_DTSVCREATE &gt;= @param7 AND GP_DTSVCREATE &lt; @param8)
                        AND GP_CAISSE IN (SELECT GPK_CAISSE FROM PARCAISSE WHERE GPK_TYPEMOBILITE in (@param9,@param10,@param11) AND GPK_ETABLISSEMENT = @param5)
                        AND GP_TYPECOMPTA != @param12
                    GROUP BY ISNULL(GPB_TAUXTAXE, 0), ISNULL(GPB_DEVISE, GP_DEVISE)
                    ORDER BY GPB_TAUXTAXE, GPB_DEVISE
16:28:15.3202409+02:00: root Verbose: 0 : Cegid.Framework.Data | SqlService | [NATIVE] SELECT ISNULL(PIEDBASE.GPB_TAUXTAXE , 0) AS GPB_TAUXTAXE, SUM(ISNULL(PIEDBASE.GPB_BASEDEV , 0)) AS GPB_BASEDEV, SUM(ISNULL(PIEDBASE.GPB_VALEURDEV , 0)) AS GPB_VALEURDEV, ISNULL(PIEDBASE.GPB_DEVISE , PIECE.GP_DEVISE) AS GPB_DEVISE FROM PIECE LEFT JOIN MPIECECOMPL ON MPIECECOMPL.MDI_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND MPIECECOMPL.MDI_SOUCHE = PIECE.GP_SOUCHE AND MPIECECOMPL.MDI_NUMERO = PIECE.GP_NUMERO AND MPIECECOMPL.MDI_TYPEFISCAL IN (@param0, @param1, @param2, @param3 ) LEFT JOIN PIEDBASE ON PIEDBASE.GPB_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND PIEDBASE.GPB_SOUCHE = PIECE.GP_SOUCHE AND PIEDBASE.GPB_NUMERO = PIECE.GP_NUMERO AND PIEDBASE.GPB_CATEGORIETAXE = RTRIM(LTRIM(PIECE.GP_CODEMODELETAXE)) + '1' WHERE PIECE.GP_NATUREPIECEG = @param4 AND PIECE.GP_ETABLISSEMENT = @param5 AND PIECE.GP_CAISSE = @param6 AND (PIECE.GP_DTSVCREATE &gt;= @param7 AND PIECE.GP_DTSVCREATE &lt; @param8) AND PIECE.GP_CAISSE IN (SELECT PARCAISSE.GPK_CAISSE FROM PARCAISSE WHERE PARCAISSE.GPK_TYPEMOBILITE IN (@param9, @param10, @param11 ) AND PARCAISSE.GPK_ETABLISSEMENT = @param5 ) AND PIECE.GP_TYPECOMPTA != @param12 GROUP BY ISNULL(PIEDBASE.GPB_TAUXTAXE , 0), ISNULL(PIEDBASE.GPB_DEVISE , PIECE.GP_DEVISE)  ORDER BY GPB_TAUXTAXE, GPB_DEVISE 
