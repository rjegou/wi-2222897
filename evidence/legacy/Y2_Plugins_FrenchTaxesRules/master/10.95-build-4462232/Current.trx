                            MNG_TARGETDATE, MNG_DATEEXEC, MNG_TOTALHT, MNG_TOTALTTC, MNG_TOTALHTPERP, MNG_TOTALTTCPERP, MNG_DEVISE, 
                            MNG_CLOIDPREC, NULL as TOTALHPPERPPREC, NULL as TOTALTTCPERPPREC, NULL as CLOSINGSIGNPREC,
