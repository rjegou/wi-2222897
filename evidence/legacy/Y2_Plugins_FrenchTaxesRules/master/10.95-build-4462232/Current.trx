  Extent1 . MN_4 MN_4, 
  Extent1 . MN_TAG MN_TAG, 
  Extent1 . MN_ACCESGRP MN_ACCESGRP 
FROM MENU Extent1 
WHERE ((26 = Extent1 . MN_1)
  AND (Extent1 . MN_TAG &gt;= 26000))
AND (('0' = SUBSTRING(Extent1 . MN_ACCESGRP, (1 - 1) + 1, 1 ))
  OR ('X' = SUBSTRING(Extent1 . MN_ACCESGRP, (1 - 1) + 1, 1 ))) 
