D PIEDBASE.GPB_CATEGORIETAXE = RTRIM(LTRIM(PIECE.GP_CODEMODELETAXE)) + '1' LEFT JOIN PARCAISSE ON PARCAISSE.GPK_CAISSE = PIECE.GP_CAISSE AND PARCAISSE.GPK_ETABLISSEMENT = PIECE.GP_ETABLISSEMENT LEFT JOIN PIECEADRESSE AS ADRESSE ON ADRESSE.GPA_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND ADRESSE.GPA_SOUCHE = PIECE.GP_SOUCHE AND ADRESSE.GPA_NUMERO = PIECE.GP_NUMERO AND ADRESSE.GPA_INDICEG = PIECE.GP_INDICEG AND ADRESSE.GPA_TYPEPIECEADR = (SELECT MAX(A2.GPA_TYPEPIECEADR) FROM PIECEADRESSE AS A2 WHERE A2.GPA_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND A2.GPA_SOUCHE = PIECE.GP_SOUCHE AND A2.GPA_NUMERO = PIECE.GP_NUMERO AND A2.GPA_INDICEG = PIECE.GP_INDICEG ) WHERE PIECE.GP_NATUREPIECEG = @param4 AND PIECE.GP_SOUCHE = @param5 AND PIECE.GP_NUMERO = @param6 AND PIECE.GP_INDICEG = @param7 AND PIECE.GP_NATUREPIECEG = @param4 
