                             m1.MDI_REFFISCALESIGN,
                             m1.MDI_FISCALPRTID,
                             m2.MDI_REFFISCALESIGN AS VLD_PREVIOUSSIGN
                        FROM PIECE
                        LEFT JOIN MPIECECOMPL AS m1 ON m1.MDI_NATUREPIECEG = GP_NATUREPIECEG AND m1.MDI_SOUCHE = GP_SOUCHE AND m1.MDI_NUMERO = GP_NUMERO AND m1.MDI_TYPEFISCAL IN (@param0,@param1) AND m1.MDI_FISCALPRTID NOT IN (@param2,@param3,@param4)
