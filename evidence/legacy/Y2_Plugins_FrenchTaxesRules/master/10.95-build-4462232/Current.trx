16:26:07.6762827+02:00: root Verbose: 0 : Cegid.Erp.Data | EFProvider | [PGI] : SELECT 
  Project2 . C1 C1, 
  Project2 . OBJECTKIND OBJECTKIND, 
  Project2 . C2 C2, 
  Project2 . OBJECTNAME OBJECTNAME, 
  Project2 . OBJECTKIND1 OBJECTKIND1, 
  Project2 . TARGETDATABASE TARGETDATABASE 
FROM (SELECT 
  Distinct1 . OBJECTKIND OBJECTKIND, 
  1 C1, 
  Extent2 . OBJECTNAME OBJECTNAME, 
  Extent2 . OBJECTKIND OBJECTKIND1, 
  Extent2 . TARGETDATABASE TARGETDATABASE, 
  CASE WHEN Extent2 . OBJECTNAME IS NULL THEN CAST(NULL AS INT) ELSE 1 END C2 
FROM (SELECT DISTINCT 
  Extent1 . OBJECTKIND OBJECTKIND 
FROM (SELECT 
  DS_NOMTABLE AS OBJECTNAME, 
  COALESCE(SUBTYPE, DS_TYPTABLE ) AS OBJECTKIND, 
  DS_NOMBASE AS TARGETDATABASE 
FROM DESHARE
LEFT OUTER JOIN (SELECT 
    DV_NOMVUE AS NAME, 
    'VUE' AS SUBTYPE 
  FROM DEVUES ) AS TABS
  ON DS_TYPTABLE = 'TAB' AND DS_NOMTABLE = NAME ) Extent1 
WHERE NOT (Extent1 . TARGETDATABASE = @p__linq__0) ) Distinct1
LEFT OUTER JOIN (SELECT 
    DS_NOMTABLE AS OBJECTNAME, 
    COALESCE(SUBTYPE, DS_TYPTABLE ) AS OBJECTKIND, 
    DS_NOMBASE AS TARGETDATABASE 
  FROM DESHARE
  LEFT OUTER JOIN (SELECT 
      DV_NOMVUE AS NAME, 
      'VUE' AS SUBTYPE 
    FROM DEVUES ) AS TABS
    ON DS_TYPTABLE = 'TAB' AND DS_NOMTABLE = NAME ) Extent2
  ON (NOT (Extent2 . TARGETDATABASE = @p__linq__0)) AND (Distinct1 . OBJECTKIND = Extent2 . OBJECTKIND) ) Project2  
ORDER BY Project2 . OBJECTKIND, Project2 . C2 
