                c.MNG_TARGETDATE, c.MNG_DATEEXEC, c.MNG_TOTALHT, c.MNG_TOTALTTC, c.MNG_TOTALHTPERP, c.MNG_TOTALTTCPERP, c.MNG_DEVISE, 
