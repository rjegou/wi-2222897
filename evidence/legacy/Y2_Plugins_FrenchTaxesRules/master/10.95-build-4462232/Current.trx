16:28:32.5159095+02:00: root Information: 0 : Cegid.Framework.Data | SqlService | [PGI] SELECT GP_NATUREPIECEG,GP_SOUCHE,GP_NUMERO,GP_INDICEG, GP_DATEPIECE,GP_HEURECREATION,GP_REFINTERNE,GP_CAISSE,GP_ETABLISSEMENT,GP_TYPEPROVENANCE,GP_DEVISE,GP_NUMPIECE,GP_TOTALHTDEV,GP_TOTALTTCDEV,GP_TOTALREMISEDEV,GP_TYPECOMPTA,GP_REPRESENTANT,GP_EDITEE,GP_TIERS,GP_NUMADRESSEFACT,GP_NUMADRESSELIVR, MDI_FISCALPRTID,MDI_REFFISCALEVAL,MDI_REFFISCALESIGN,MDI_NUMVERSION,
                                (SELECT COUNT(*) FROM LIGNE
                                   WHERE GL_NATUREPIECEG = GP_NATUREPIECEG AND GL_SOUCHE  = GP_SOUCHE
                                     AND GL_NUMERO       = GP_NUMERO       AND GL_INDICEG = GP_INDICEG
                                     AND GL_MONTANTTTCDEV &lt; 0) AS RETURN_COUNT,
                                (SELECT COUNT(*) FROM LIGNE
                                   WHERE GL_NATUREPIECEG = GP_NATUREPIECEG AND GL_SOUCHE  = GP_SOUCHE
                                     AND GL_NUMERO       = GP_NUMERO       AND GL_INDICEG = GP_INDICEG) AS LINE_COUNT
                        FROM PIECE
                        LEFT JOIN MPIECECOMPL ON MDI_NATUREPIECEG = GP_NATUREPIECEG AND MDI_SOUCHE = GP_SOUCHE AND MDI_NUMERO = GP_NUMERO AND MDI_TYPEFISCAL IN (@param1,@param2) AND MDI_FISCALPRTID NOT IN (@param3,@param4,@param5)
                        WHERE GP_NATUREPIECEG = @param6
                            AND GP_ETABLISSEMENT = @param7
                            AND GP_DTSVCREATE &gt;= @param8 AND GP_DTSVCREATE &lt; @param9
                            AND GP_TYPECOMPTA != @param0
                        ORDER BY GP_ETABLISSEMENT, GP_CAISSE, GP_NATUREPIECEG, GP_SOUCHE, GP_NUMERO, GP_INDICEG
