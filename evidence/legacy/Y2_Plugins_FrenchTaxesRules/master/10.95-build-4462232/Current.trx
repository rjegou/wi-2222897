16:28:20.4330753+02:00: root Information: 0 : Cegid.Framework.Data | SqlService | [PGI] SELECT GP_NATUREPIECEG,GP_SOUCHE,GP_NUMERO,GP_INDICEG,GP_DATEPIECE,GP_HEURECREATION,GP_REFINTERNE,GP_CAISSE,GP_ETABLISSEMENT,GP_TYPEPROVENANCE,GP_DEVISE,GP_NUMPIECE,GP_TOTALHTDEV,GP_TOTALTTCDEV,GP_TOTALREMISEDEV,GP_TYPECOMPTA,GP_REPRESENTANT,GP_EDITEE,GP_TIERS,GP_NUMADRESSEFACT,GP_NUMADRESSELIVR,
                             GPA_LIBELLE,GPA_CODEPOSTAL,GPA_NIF,
                             MDI_FISCALPRTID,MDI_REFFISCALEVAL,MDI_REFFISCALESIGN,MDI_NUMVERSION,
                             ISNULL(GPB_TAUXTAXE, 0) AS GPB_TAUXTAXE, 
               ISNULL(GPB_BASEDEV, GP_TOTALTTCDEV) AS GPB_BASEDEV,
               ISNULL(GPB_VALEURDEV, 0) AS GPB_VALEURDEV,
               ISNULL(GPB_DEVISE, GP_DEVISE) AS GPB_DEVISE,
               GPB_FAMILLETAXE,
                             (SELECT COUNT(*) FROM LIGNE
                                WHERE GL_NATUREPIECEG = GP_NATUREPIECEG AND GL_SOUCHE  = GP_SOUCHE
                                  AND GL_NUMERO       = GP_NUMERO       AND GL_INDICEG = GP_INDICEG
                                  AND GL_MONTANTTTCDEV &lt; 0) AS RETURN_COUNT,
                             (SELECT COUNT(*) FROM LIGNE
                                WHERE GL_NATUREPIECEG = GP_NATUREPIECEG AND GL_SOUCHE  = GP_SOUCHE
                                  AND GL_NUMERO       = GP_NUMERO       AND GL_INDICEG = GP_INDICEG) AS LINE_COUNT
                        FROM PIECE
                        LEFT JOIN MPIECECOMPL ON MDI_NATUREPIECEG = GP_NATUREPIECEG AND MDI_SOUCHE = GP_SOUCHE AND MDI_NUMERO = GP_NUMERO AND MDI_TYPEFISCAL IN (@param1,@param2) AND MDI_FISCALPRTID NOT IN (@param3,@param4,@param5)
                        LEFT JOIN PIEDBASE ON GPB_NATUREPIECEG = GP_NATUREPIECEG AND GPB_SOUCHE = GP_SOUCHE AND GPB_NUMERO = GP_NUMERO AND GPB_INDICEG = GP_INDICEG AND GPB_CATEGORIETAXE = TRIM(GP_CODEMODELETAXE) + '1'
                        LEFT JOIN PIECEADRESSE ADRESSE
                               ON GPA_NATUREPIECEG = GP_NATUREPIECEG AND GPA_SOUCHE = GP_SOUCHE
                              AND GPA_NUMERO       = GP_NUMERO       AND GPA_INDICEG = GP_INDICEG
                              AND GPA_TYPEPIECEADR = (SELECT MAX(A2.GPA_TYPEPIECEADR)
                                                        FROM PIECEADRESSE A2
                                                       WHERE A2.GPA_NATUREPIECEG = GP_NATUREPIECEG
                                                         AND A2.GPA_SOUCHE       = GP_SOUCHE
                                                         AND A2.GPA_NUMERO       = GP_NUMERO
                                                         AND A2.GPA_INDICEG      = GP_INDICEG)
                        WHERE GP_NATUREPIECEG = @param6
                            AND GP_ETABLISSEMENT = @param7
                            AND GP_DTSVCREATE BETWEEN @param8 AND @param9
                            AND GP_CAISSE IN (SELECT GPK_CAISSE FROM PARCAISSE WHERE GPK_TYPEMOBILITE in (@param10,@param11,@param12) AND GPK_ETABLISSEMENT = @param7)
                            AND GP_TYPECOMPTA != @param0
                        ORDER BY GP_CAISSE, MDI_REFFISCALEVAL, GPB_NUMLIGNE
