16:27:09.4946381+02:00: root Information: 0 : Cegid.Framework.Data | SqlService | [PGI] SELECT TOP 1 GHE_CODESITE,GHE_NUMERO,GHE_NIVEAU3,GHE_RESUME,GHE_DATECREATION,GHE_UTILISATEUR,GHE_CODESITE,GHS_EVENTSIGN,GHS_SIGNVERSION,CKY_SIGNKEYVERSION,CKY_CUSTOMERKEY
                            FROM JOURNALEVENT
                            LEFT JOIN JOURNALEVENTSIGN ON GHS_ETABLISSEMENT = GHE_CODESITE AND GHS_NUMERO = GHE_NUMERO
                            LEFT JOIN CUSTOMERKEY ON CKY_SIGNKEYVERSION = GHS_SIGNKEYVERSION
                            WHERE GHE_CODESITE = @param0
                                AND GHE_NUMERO &lt; @param1
