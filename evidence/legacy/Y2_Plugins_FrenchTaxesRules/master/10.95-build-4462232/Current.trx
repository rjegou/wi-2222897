16:26:07.8481686+02:00: root Verbose: 0 : Cegid.Erp.Data | EFProvider | [PGI] : SELECT 
  1 C1, 
  Extent1 . US_UTILISATEUR US_UTILISATEUR, 
  Extent1 . US_LIBELLE US_LIBELLE, 
  Extent1 . US_ABREGE US_ABREGE, 
  Extent1 . US_AUXILIAIRE US_AUXILIAIRE, 
  Extent1 . US_DOMAINEAUTHENT US_DOMAINEAUTHENT, 
  Extent1 . US_GROUPE US_GROUPE, 
  Extent2 . UG_GROUPE UG_GROUPE, 
  Extent2 . UG_LANGUE UG_LANGUE 
FROM UTILISAT Extent1
LEFT OUTER JOIN USERGRP Extent2
  ON Extent1 . US_GROUPE = Extent2 . UG_GROUPE 
WHERE (UPPER(Extent1 . US_ABREGE ) = UPPER(@p__linq__0 ))
AND (CASE WHEN UPPER(Extent1 . US_DOMAINEAUTHENT ) IS NULL
  AND UPPER(@p__linq__1 ) IS NULL
  OR UPPER(Extent1 . US_DOMAINEAUTHENT ) = UPPER(@p__linq__1 ) THEN 1 ELSE 0 END = CAST(1 AS BIT)) 
