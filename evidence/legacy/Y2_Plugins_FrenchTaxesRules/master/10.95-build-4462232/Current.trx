16:26:19.8458482+02:00: root Information: 0 : Cegid.Framework.Data | SqlService | [PGI] SELECT GP_NATUREPIECEG,GP_SOUCHE,GP_NUMERO,GP_INDICEG,GP_DATEPIECE,GP_HEURECREATION,GP_REFINTERNE,GP_CAISSE,GP_ETABLISSEMENT,GP_TYPEPROVENANCE,GP_DEVISE,GP_NUMPIECE,GP_TOTALHTDEV,GP_TOTALTTCDEV,GP_TOTALREMISEDEV,GP_TYPECOMPTA,GP_REPRESENTANT,GP_EDITEE,GP_TIERS,GP_NUMADRESSEFACT,GP_NUMADRESSELIVR,MDI_FISCALPRTID,MDI_REFFISCALEVAL,MDI_REFFISCALESIGN,MDI_NUMVERSION,
                                ISNULL(GPB_TAUXTAXE, 0) AS GPB_TAUXTAXE, ISNULL(GPB_BASEDEV, 0) AS GPB_BASEDEV, ISNULL(GPB_VALEURDEV, 0) AS GPB_VALEURDEV, ISNULL(GPB_DEVISE, GP_DEVISE) AS GPB_DEVISE,
                            (SELECT MDI_REFFISCALESIGN FROM SIGNLINK O
                            LEFT JOIN MPIECECOMPL ON MDI_NATUREPIECEG=O.SIL_NATUREPIECEG AND MDI_SOUCHE=O.SIL_SOUCHE AND MDI_NUMERO=O.SIL_NUMERO
                            WHERE O.SIL_RANG=@param0
                            AND O.SIL_LINKID = (SELECT D.SIL_LINKID FROM SIGNLINK D WHERE D.SIL_RANG=@param1
                                                AND D.SIL_NATUREPIECEG=GP_NATUREPIECEG
                                                AND D.SIL_SOUCHE=GP_SOUCHE
                                                AND D.SIL_NUMERO=GP_NUMERO)) AS VLD_PREVIOUSSIGN
                            FROM PIECE
                                LEFT JOIN MPIECECOMPL ON MDI_NATUREPIECEG = GP_NATUREPIECEG AND MDI_SOUCHE = GP_SOUCHE AND MDI_NUMERO = GP_NUMERO
                                                         AND MDI_TYPEFISCAL IN (@param2,@param3,@param4,@param5)
                                LEFT JOIN PIEDBASE ON GPB_NATUREPIECEG = GP_NATUREPIECEG AND GPB_SOUCHE = GP_SOUCHE AND GPB_NUMERO = GP_NUMERO AND GPB_CATEGORIETAXE = TRIM(GP_CODEMODELETAXE) + '1'
                            WHERE GP_NATUREPIECEG = @param6 
                                AND GP_ETABLISSEMENT = @param7
                                AND (GP_DTSVCREATE &gt;= @param8 AND GP_DTSVCREATE &lt; @param9)
                                AND (GP_CAISSE NOT IN (SELECT GPK_CAISSE FROM PARCAISSE WHERE GPK_TYPEMOBILITE in (@param10,@param11,@param12) AND GPK_ETABLISSEMENT = @param7))
                                AND GP_TYPECOMPTA != @param13
                                AND (MDI_FISCALPRTID = '' OR MDI_FISCALPRTID IS NULL OR MDI_FISCALPRTID &gt;= @param14)
                            ORDER BY GP_CAISSE, MDI_REFFISCALEVAL, GPB_NUMLIGNE
