16:26:09.2075828+02:00: root Verbose: 0 : Cegid.Erp.Data | EFProvider | [PGI] : SELECT 
  Project1 . MN_TAG MN_TAG 
FROM (SELECT 
  Extent1 . MN_TAG MN_TAG 
FROM MENU Extent1 
WHERE ((((((((NOT (Extent1 . MN_LIBELLE IS NULL))
              AND (NOT ('-' = Extent1 . MN_LIBELLE)))
            AND (NOT (Extent1 . MN_TAG IS NULL)))
          AND (Extent1 . MN_TAG &gt; 0))
        AND (NOT (Extent1 . MN_1 IS NULL)))
      AND (NOT (26 = Extent1 . MN_1)))
    AND (NOT (Extent1 . MN_ACCESGRP IS NULL)))
  AND (LENGTH(Extent1 . MN_ACCESGRP ) &gt;= @p__linq__0))
AND (('0' = SUBSTRING(Extent1 . MN_ACCESGRP, (@p__linq__1 - 1) + 1, 1 ))
  OR ('X' = SUBSTRING(Extent1 . MN_ACCESGRP, (@p__linq__2 - 1) + 1, 1 ))) ) Project1  
ORDER BY Project1 . MN_TAG 
