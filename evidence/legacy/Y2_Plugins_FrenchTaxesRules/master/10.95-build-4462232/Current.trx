16:28:17.4067666+02:00: root Information: 0 : Cegid.Framework.Data | SqlService | [PGI] SELECT ISNULL(GPB_TAUXTAXE, 0) AS GPB_TAUXTAXE, SUM(ISNULL(GPB_BASEDEV, 0)) AS GPB_BASEDEV, SUM(ISNULL(GPB_VALEURDEV, 0)) AS GPB_VALEURDEV, ISNULL(GPB_DEVISE, GP_DEVISE) AS GPB_DEVISE
                    FROM PIECE
                        LEFT JOIN MPIECECOMPL ON MDI_NATUREPIECEG = GP_NATUREPIECEG AND MDI_SOUCHE = GP_SOUCHE AND MDI_NUMERO = GP_NUMERO
                                                    AND MDI_TYPEFISCAL IN (@param0,@param1,@param2,@param3)
                        LEFT JOIN PIEDBASE ON GPB_NATUREPIECEG = GP_NATUREPIECEG AND GPB_SOUCHE = GP_SOUCHE AND GPB_NUMERO = GP_NUMERO AND GPB_CATEGORIETAXE = TRIM(GP_CODEMODELETAXE) + '1'
                    WHERE GP_NATUREPIECEG=@param4
                        AND GP_ETABLISSEMENT=@param5
                        AND GP_CAISSE = @param6
                        AND (GP_DTSVCREATE &gt;= @param7 AND GP_DTSVCREATE &lt; @param8)
                        AND GP_CAISSE IN (SELECT GPK_CAISSE FROM PARCAISSE WHERE GPK_TYPEMOBILITE in (@param9,@param10,@param11) AND GPK_ETABLISSEMENT = @param5)
                        AND GP_TYPECOMPTA != @param12
                    GROUP BY ISNULL(GPB_TAUXTAXE, 0), ISNULL(GPB_DEVISE, GP_DEVISE)
                    ORDER BY GPB_TAUXTAXE, GPB_DEVISE
