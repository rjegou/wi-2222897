IECEG = LIGNE.GL_NATUREPIECEG AND b2.GPB_SOUCHE = LIGNE.GL_SOUCHE AND b2.GPB_NUMERO = LIGNE.GL_NUMERO AND b2.GPB_INDICEG = LIGNE.GL_INDICEG AND b2.GPB_CATEGORIETAXE = RTRIM(LTRIM(LIGNE.GL_CODEMODELETAXE)) + '2' LEFT JOIN LIGNEREMISE ON LIGNEREMISE.MLR_NATUREPIECEG = LIGNE.GL_NATUREPIECEG AND LIGNEREMISE.MLR_SOUCHE = LIGNE.GL_SOUCHE AND LIGNEREMISE.MLR_NUMERO = LIGNE.GL_NUMERO AND LIGNEREMISE.MLR_INDICEG = LIGNE.GL_INDICEG AND LIGNEREMISE.MLR_NUMLIGNE = LIGNE.GL_NUMLIGNE LEFT JOIN ARTICLE ON ARTICLE.GA_ARTICLE = LIGNE.GL_ARTICLE LEFT JOIN CHOIXCOD ON CHOIXCOD.CC_CODE = LIGNE.GL_FAMILLETAXE1 AND CHOIXCOD.CC_TYPE = 'TX1' WHERE PIECE.GP_NATUREPIECEG = @param1 AND PIECE.GP_ETABLISSEMENT = @param2 AND PIECE.GP_DTSVCREATE &gt;= @param3 AND PIECE.GP_DTSVCREATE &lt; @param4 AND PIECE.GP_TYPECOMPTA != @param0  ORDER BY GL_NATUREPIECEG, GL_SOUCHE, GL_NUMERO, GL_INDICEG, GL_NUMLIGNE 
