16:27:07.0837586+02:00: root Information: 0 : Cegid.Framework.Data | SqlService | [PGI] SELECT GP_NATUREPIECEG,GP_SOUCHE,GP_NUMERO,GP_INDICEG,GP_DATEPIECE,GP_HEURECREATION,GP_REFINTERNE,GP_CAISSE,GP_ETABLISSEMENT,GP_TYPEPROVENANCE,GP_DEVISE,GP_NUMPIECE,GP_TOTALHTDEV,GP_TOTALTTCDEV,GP_TOTALREMISEDEV,GP_TYPECOMPTA,GP_REPRESENTANT,GP_EDITEE,GP_TIERS,GP_NUMADRESSEFACT,GP_NUMADRESSELIVR,MDI_FISCALPRTID,MDI_REFFISCALEVAL,MDI_REFFISCALESIGN,MDI_NUMVERSION, 
                                GPA_LIBELLE,GPA_CODEPOSTAL,GPA_NIF,
                                ISNULL(GPB_TAUXTAXE, 0) AS GPB_TAUXTAXE, 
               ISNULL(GPB_BASEDEV, GP_TOTALTTCDEV) AS GPB_BASEDEV,
               ISNULL(GPB_VALEURDEV, 0) AS GPB_VALEURDEV,
               ISNULL(GPB_DEVISE, GP_DEVISE) AS GPB_DEVISE,
               GPB_FAMILLETAXE,
                                (SELECT COUNT(*) FROM LIGNE                       -- RETURN_COUNT corrélé (seek sur la clé)
                                   WHERE GL_NATUREPIECEG = GP_NATUREPIECEG AND GL_SOUCHE  = GP_SOUCHE
                                     AND GL_NUMERO       = GP_NUMERO       AND GL_INDICEG = GP_INDICEG
                                     AND GL_MONTANTTTCDEV &lt; 0) AS RETURN_COUNT,
                                (SELECT COUNT(*) FROM LIGNE                       -- LINE_COUNT corrélé (seek sur la clé)
                                   WHERE GL_NATUREPIECEG = GP_NATUREPIECEG AND GL_SOUCHE  = GP_SOUCHE
                                     AND GL_NUMERO       = GP_NUMERO       AND GL_INDICEG = GP_INDICEG) AS LINE_COUNT,
                                GPK_TYPEMOBILITE
                            FROM PIECE
                            LEFT JOIN MPIECECOMPL ON MDI_NATUREPIECEG = GP_NATUREPIECEG AND MDI_SOUCHE = GP_SOUCHE AND MDI_NUMERO = GP_NUMERO AND MDI_TYPEFISCAL IN (@param0,@param1,@param2,@param3)
                            LEFT JOIN PIEDBASE ON GPB_NATUREPIECEG = GP_NATUREPIECEG AND GPB_SOUCHE = GP_SOUCHE AND GPB_NUMERO = GP_NUMERO AND GPB_INDICEG = GP_INDICEG AND GPB_CATEGORIETAXE = TRIM(GP_CODEMODELETAXE) + '1'
                            LEFT JOIN PARCAISSE ON GPK_CAISSE = GP_CAISSE AND GPK_ETABLISSEMENT = GP_ETABLISSEMENT
                            LEFT JOIN PIECEADRESSE ADRESSE                            -- adresse corrélée (seek sur la clé)
                               ON GPA_NATUREPIECEG = GP_NATUREPIECEG AND GPA_SOUCHE = GP_SOUCHE
                              AND GPA_NUMERO       = GP_NUMERO       AND GPA_INDICEG = GP_INDICEG
                              AND GPA_TYPEPIECEADR = (SELECT MAX(A2.GPA_TYPEPIECEADR)
                                                        FROM PIECEADRESSE A2
                                                       WHERE A2.GPA_NATUREPIECEG = GP_NATUREPIECEG
                                                         AND A2.GPA_SOUCHE       = GP_SOUCHE
                                                         AND A2.GPA_NUMERO       = GP_NUMERO
                                                         AND A2.GPA_INDICEG      = GP_INDICEG)
                            WHERE GP_NATUREPIECEG = @param4 
                            AND GP_SOUCHE = @param5
                            AND GP_NUMERO = @param6
                            AND GP_INDICEG = @param7
                            AND GP_NATUREPIECEG = @param4
16:27:07.0993922+02:00: root Verbose: 0 : Cegid.Framework.Data | SqlService | [NATIVE] SELECT PIECE.GP_NATUREPIECEG, PIECE.GP_SOUCHE, PIECE.GP_NUMERO, PIECE.GP_INDICEG, PIECE.GP_DATEPIECE, PIECE.GP_HEURECREATION, PIECE.GP_REFINTERNE, PIECE.GP_CAISSE, PIECE.GP_ETABLISSEMENT, PIECE.GP_TYPEPROVENANCE, PIECE.GP_DEVISE, PIECE.GP_NUMPIECE, PIECE.GP_TOTALHTDEV, PIECE.GP_TOTALTTCDEV, PIECE.GP_TOTALREMISEDEV, PIECE.GP_TYPECOMPTA, PIECE.GP_REPRESENTANT, PIECE.GP_EDITEE, PIECE.GP_TIERS, PIECE.GP_NUMADRESSEFACT, PIECE.GP_NUMADRESSELIVR, MPIECECOMPL.MDI_FISCALPRTID, MPIECECOMPL.MDI_REFFISCALEVAL, MPIECECOMPL.MDI_REFFISCALESIGN, MPIECECOMPL.MDI_NUMVERSION, ADRESSE.GPA_LIBELLE, ADRESSE.GPA_CODEPOSTAL, ADRESSE.GPA_NIF, ISNULL(PIEDBASE.GPB_TAUXTAXE , 0) AS GPB_TAUXTAXE, ISNULL(PIEDBASE.GPB_BASEDEV , PIECE.GP_TOTALTTCDEV) AS GPB_BASEDEV, ISNULL(PIEDBASE.GPB_VALEURDEV , 0) AS GPB_VALEURDEV, ISNULL(PIEDBASE.GPB_DEVISE , PIECE.GP_DEVISE) AS GPB_DEVISE, PIEDBASE.GPB_FAMILLETAXE, (SELECT COUNT(*) FROM LIGNE WHERE LIGNE.GL_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND LIGNE.GL_SOUCHE = PIECE.GP_SOUCHE AND LIGNE.GL_NUMERO = PIECE.GP_NUMERO AND LIGNE.GL_INDICEG = PIECE.GP_INDICEG AND LIGNE.GL_MONTANTTTCDEV &lt; 0 ) AS RETURN_COUNT, (SELECT COUNT(*) FROM LIGNE WHERE LIGNE.GL_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND LIGNE.GL_SOUCHE = PIECE.GP_SOUCHE AND LIGNE.GL_NUMERO = PIECE.GP_NUMERO AND LIGNE.GL_INDICEG = PIECE.GP_INDICEG ) AS LINE_COUNT, PARCAISSE.GPK_TYPEMOBILITE FROM PIECE LEFT JOIN MPIECECOMPL ON MPIECECOMPL.MDI_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND MPIECECOMPL.MDI_SOUCHE = PIECE.GP_SOUCHE AND MPIECECOMPL.MDI_NUMERO = PIECE.GP_NUMERO AND MPIECECOMPL.MDI_TYPEFISCAL IN (@param0, @param1, @param2, @param3 ) LEFT JOIN PIEDBASE ON PIEDBASE.GPB_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND PIEDBASE.GPB_SOUCHE = PIECE.GP_SOUCHE AND PIEDBASE.GPB_NUMERO = PIECE.GP_NUMERO AND PIEDBASE.GPB_INDICEG = PIECE.GP_INDICEG AND PIEDBASE.GPB_CATEGORIETAXE = RTRIM(LTRIM(PIECE.GP_CODEMODELETAXE)) + '1' LEFT JOIN PARCAISSE ON PARCAISSE.GPK_CAISSE = PIECE.GP_CAISSE AND PARCAISSE.GPK_ETABLISSEMENT = PIECE.GP_ETABLISSEMENT LEFT JOIN PIECEADRESSE AS ADRESSE ON ADRESSE.GPA_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND ADRESSE.GPA_SOUCHE = PIECE.GP_SOUCHE AND ADRESSE.GPA_NUMERO = PIECE.GP_NUMERO AND ADRESSE.GPA_INDICEG = PIECE.GP_INDICEG AND ADRESSE.GPA_TYPEPIECEADR = (SELECT MAX(A2.GPA_TYPEPIECEADR) FROM PIECEADRESSE AS A2 WHERE A2.GPA_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND A2.GPA_SOUCHE = PIECE.GP_SOUCHE AND A2.GPA_NUMERO = PIECE.GP_NUMERO AND A2.GPA_INDICEG = PIECE.GP_INDICEG ) WHERE PIECE.GP_NATUREPIECEG = @param4 AND PIECE.GP_SOUCHE = @param5 AND PIECE.GP_NUMERO = @param6 AND PIECE.GP_INDICEG = @param7 AND PIECE.GP_NATUREPIECEG = @param4 
