16:28:30.3321720+02:00: root Information: 0 : Cegid.Framework.Data | SqlService | [PGI] SELECT MNG_CLOID, MNG_DAEMONID, MNG_CAISSE, DAE_ETABLISS, MNG_LEVEL, MNG_CLOTYPE, 
                            MNG_TARGETDATE, MNG_DATEEXEC, MNG_TOTALHT, MNG_TOTALTTC, MNG_TOTALHTPERP, MNG_TOTALTTCPERP, MNG_DEVISE, 
                            MNG_CLOIDPREC, NULL as TOTALHPPERPPREC, NULL as TOTALTTCPERPPREC, NULL as CLOSINGSIGNPREC,
                            MNG_CLOSINGSIGN, DAE_SIGNVERSION, NULL as CKY_SIGNKEYVERSION, NULL as CKY_CUSTOMERKEY,
                            CTA_CLOID, CTA_TAUXTAXE, CTA_BASETAXE, CTA_VALEURTAXE, CTA_DEVISE 
                        FROM DAEMON
                        JOIN CLOSING ON MNG_DAEMONID = DAE_DAEMONID
                        LEFT JOIN CLOSINGTAX ON CTA_CLOID = MNG_CLOID
                        WHERE MNG_CLOTYPE in (@param1)
                          AND DAE_ETABLISS = @param2
