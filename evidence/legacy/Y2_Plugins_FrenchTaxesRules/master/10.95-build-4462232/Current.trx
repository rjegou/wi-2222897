16:28:28.4164208+02:00: root Information: 0 : Cegid.Framework.Data | SqlService | [PGI] SELECT GP_NATUREPIECEG,GP_SOUCHE,GP_NUMERO,GP_INDICEG, 
                                ISNULL(GPB_TAUXTAXE, 0) AS GPB_TAUXTAXE, 
               ISNULL(GPB_BASEDEV, GP_TOTALTTCDEV) AS GPB_BASEDEV,
               ISNULL(GPB_VALEURDEV, 0) AS GPB_VALEURDEV,
               ISNULL(GPB_DEVISE, GP_DEVISE) AS GPB_DEVISE,
               GPB_FAMILLETAXE, 
                                CC_LIBELLE
                        FROM PIECE
                        LEFT JOIN PIEDBASE ON GPB_NATUREPIECEG = GP_NATUREPIECEG AND GPB_SOUCHE = GP_SOUCHE AND GPB_NUMERO = GP_NUMERO AND GPB_INDICEG = GP_INDICEG
                        LEFT JOIN CHOIXCOD on CC_CODE = GPB_FAMILLETAXE AND CC_TYPE = 'TX1'
                        WHERE GP_NATUREPIECEG = @param1 
                            AND GP_ETABLISSEMENT = @param2
                            AND GP_DTSVCREATE &gt;= @param3 AND GP_DTSVCREATE &lt; @param4
                            AND GP_TYPECOMPTA != @param0
                        ORDER BY GPB_NATUREPIECEG, GPB_SOUCHE, GPB_NUMERO, GPB_INDICEG
