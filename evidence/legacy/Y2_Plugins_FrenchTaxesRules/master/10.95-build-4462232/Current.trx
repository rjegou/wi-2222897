16:28:32.5471594+02:00: root Information: 0 : Cegid.Framework.Data | SqlService | [PGI] SELECT GP_NATUREPIECEG,GP_SOUCHE,GP_NUMERO,GP_INDICEG,GP_DATEPIECE,GP_HEURECREATION,GP_REFINTERNE,GP_CAISSE,GP_ETABLISSEMENT,GP_TYPEPROVENANCE,GP_DEVISE,GP_NUMPIECE,GP_TOTALHTDEV,GP_TOTALTTCDEV,GP_TOTALREMISEDEV,GP_TYPECOMPTA,GP_REPRESENTANT,GP_EDITEE,GP_TIERS,GP_NUMADRESSEFACT,GP_NUMADRESSELIVR,
                             GPA_LIBELLE,GPA_CODEPOSTAL,GPA_NIF,
                             MDI_FISCALPRTID,MDI_REFFISCALEVAL,MDI_REFFISCALESIGN,MDI_NUMVERSION,
                             ISNULL(GPB_TAUXTAXE, 0) AS GPB_TAUXTAXE, 
               ISNULL(GPB_BASEDEV, GP_TOTALTTCDEV) AS GPB_BASEDEV,
               ISNULL(GPB_VALEURDEV, 0) AS GPB_VALEURDEV,
               ISNULL(GPB_DEVISE, GP_DEVISE) AS GPB_DEVISE,
               GPB_FAMILLETAXE,
                             (SELECT COUNT(*) FROM LIGNE
                                WHERE GL_NATUREPIECEG = GP_NATUREPIECEG AND GL_SOUCHE  = GP_SOUCHE
                                  AND GL_NUMERO       = GP_NUMERO       AND GL_INDICEG = GP_INDICEG
                                  AND GL_MONTANTTTCDEV &lt; 0) AS RETURN_COUNT,
                             (SELECT COUNT(*) FROM LIGNE
                                WHERE GL_NATUREPIECEG = GP_NATUREPIECEG AND GL_SOUCHE  = GP_SOUCHE
                                  AND GL_NUMERO       = GP_NUMERO       AND GL_INDICEG = GP_INDICEG) AS LINE_COUNT
                        FROM PIECE
                        LEFT JOIN MPIECECOMPL ON MDI_NATUREPIECEG = GP_NATUREPIECEG AND MDI_SOUCHE = GP_SOUCHE AND MDI_NUMERO = GP_NUMERO AND MDI_TYPEFISCAL IN (@param1,@param2) AND MDI_FISCALPRTID NOT IN (@param3,@param4,@param5)
                        LEFT JOIN PIEDBASE ON GPB_NATUREPIECEG = GP_NATUREPIECEG AND GPB_SOUCHE = GP_SOUCHE AND GPB_NUMERO = GP_NUMERO AND GPB_INDICEG = GP_INDICEG AND GPB_CATEGORIETAXE = TRIM(GP_CODEMODELETAXE) + '1'
                        LEFT JOIN PIECEADRESSE ADRESSE
                               ON GPA_NATUREPIECEG = GP_NATUREPIECEG AND GPA_SOUCHE = GP_SOUCHE
                              AND GPA_NUMERO       = GP_NUMERO       AND GPA_INDICEG = GP_INDICEG
                              AND GPA_TYPEPIECEADR = (SELECT MAX(A2.GPA_TYPEPIECEADR)
                                                        FROM PIECEADRESSE A2
                                                       WHERE A2.GPA_NATUREPIECEG = GP_NATUREPIECEG
                                                         AND A2.GPA_SOUCHE       = GP_SOUCHE
                                                         AND A2.GPA_NUMERO       = GP_NUMERO
                                                         AND A2.GPA_INDICEG      = GP_INDICEG)
                        WHERE GP_NATUREPIECEG = @param6
                            AND GP_ETABLISSEMENT = @param7
                            AND GP_DTSVCREATE BETWEEN @param8 AND @param9
                            AND GP_CAISSE IN (SELECT GPK_CAISSE FROM PARCAISSE WHERE GPK_TYPEMOBILITE in (@param10,@param11,@param12) AND GPK_ETABLISSEMENT = @param7)
                            AND GP_TYPECOMPTA != @param0
                        ORDER BY GP_CAISSE, MDI_REFFISCALEVAL, GPB_NUMLIGNE
16:28:32.5627850+02:00: root Verbose: 0 : Cegid.Framework.Data | SqlService | [NATIVE] SELECT PIECE.GP_NATUREPIECEG, PIECE.GP_SOUCHE, PIECE.GP_NUMERO, PIECE.GP_INDICEG, PIECE.GP_DATEPIECE, PIECE.GP_HEURECREATION, PIECE.GP_REFINTERNE, PIECE.GP_CAISSE, PIECE.GP_ETABLISSEMENT, PIECE.GP_TYPEPROVENANCE, PIECE.GP_DEVISE, PIECE.GP_NUMPIECE, PIECE.GP_TOTALHTDEV, PIECE.GP_TOTALTTCDEV, PIECE.GP_TOTALREMISEDEV, PIECE.GP_TYPECOMPTA, PIECE.GP_REPRESENTANT, PIECE.GP_EDITEE, PIECE.GP_TIERS, PIECE.GP_NUMADRESSEFACT, PIECE.GP_NUMADRESSELIVR, ADRESSE.GPA_LIBELLE, ADRESSE.GPA_CODEPOSTAL, ADRESSE.GPA_NIF, MPIECECOMPL.MDI_FISCALPRTID, MPIECECOMPL.MDI_REFFISCALEVAL, MPIECECOMPL.MDI_REFFISCALESIGN, MPIECECOMPL.MDI_NUMVERSION, ISNULL(PIEDBASE.GPB_TAUXTAXE , 0) AS GPB_TAUXTAXE, ISNULL(PIEDBASE.GPB_BASEDEV , PIECE.GP_TOTALTTCDEV) AS GPB_BASEDEV, ISNULL(PIEDBASE.GPB_VALEURDEV , 0) AS GPB_VALEURDEV, ISNULL(PIEDBASE.GPB_DEVISE , PIECE.GP_DEVISE) AS GPB_DEVISE, PIEDBASE.GPB_FAMILLETAXE, (SELECT COUNT(*) FROM LIGNE WHERE LIGNE.GL_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND LIGNE.GL_SOUCHE = PIECE.GP_SOUCHE AND LIGNE.GL_NUMERO = PIECE.GP_NUMERO AND LIGNE.GL_INDICEG = PIECE.GP_INDICEG AND LIGNE.GL_MONTANTTTCDEV &lt; 0 ) AS RETURN_COUNT, (SELECT COUNT(*) FROM LIGNE WHERE LIGNE.GL_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND LIGNE.GL_SOUCHE = PIECE.GP_SOUCHE AND LIGNE.GL_NUMERO = PIECE.GP_NUMERO AND LIGNE.GL_INDICEG = PIECE.GP_INDICEG ) AS LINE_COUNT FROM PIECE LEFT JOIN MPIECECOMPL ON MPIECECOMPL.MDI_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND MPIECECOMPL.MDI_SOUCHE = PIECE.GP_SOUCHE AND MPIECECOMPL.MDI_NUMERO = PIECE.GP_NUMERO AND MPIECECOMPL.MDI_TYPEFISCAL IN (@param1, @param2 ) AND MPIECECOMPL.MDI_FISCALPRTID NOT IN (@param3, @param4, @param5 ) LEFT JOIN PIEDBASE ON PIEDBASE.GPB_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND PIEDBASE.GPB_SOUCHE = PIECE.GP_SOUCHE AND PIEDBASE.GPB_NUMERO = PIECE.GP_NUMERO AND PIEDBASE.GPB_INDICEG = PIECE.GP_INDICEG AND PIEDBASE.GPB_CATEGORIETAXE = RTRIM(LTRIM(PIECE.GP_CODEMODELETAXE)) + '1' LEFT JOIN PIECEADRESSE AS ADRESSE ON ADRESSE.GPA_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND ADRESSE.GPA_SOUCHE = PIECE.GP_SOUCHE AND ADRESSE.GPA_NUMERO = PIECE.GP_NUMERO AND ADRESSE.GPA_INDICEG = PIECE.GP_INDICEG AND ADRESSE.GPA_TYPEPIECEADR = (SELECT MAX(A2.GPA_TYPEPIECEADR) FROM PIECEADRESSE AS A2 WHERE A2.GPA_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND A2.GPA_SOUCHE = PIECE.GP_SOUCHE AND A2.GPA_NUMERO = PIECE.GP_NUMERO AND A2.GPA_INDICEG = PIECE.GP_INDICEG ) WHERE PIECE.GP_NATUREPIECEG = @param6 AND PIECE.GP_ETABLISSEMENT = @param7 AND PIECE.GP_DTSVCREATE BETWEEN @param8 AND @param9 AND PIECE.GP_CAISSE IN (SELECT PARCAISSE.GPK_CAISSE FROM PARCAISSE WHERE PARCAISSE.GPK_TYPEMOBILITE IN (@param10, @param11, @param12 ) AND PARCAISSE.GPK_ETABLISSEMENT = @param7 ) AND PIECE.GP_TYPECOMPTA != @param0  ORDER BY GP_CAISSE, MDI_REFFISCALEVAL, GPB_NUMLIGNE 
