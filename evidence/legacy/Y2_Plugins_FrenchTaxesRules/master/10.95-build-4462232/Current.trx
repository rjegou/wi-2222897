16:28:13.8784657+02:00: root Verbose: 0 : Cegid.Erp.Data | EFProvider | [PGI] : SELECT 
  Project2 . C1 C1, 
  Project2 . TDC_TYP TDC_TYP, 
  Project2 . C2 C2, 
  Project2 . TDC_NOM TDC_NOM, 
  Project2 . TDC_TYP1 TDC_TYP1, 
  Project2 . TDC_CLE TDC_CLE, 
  Project2 . TDC_LANGREFSRC TDC_LANGREFSRC 
FROM (SELECT 
  Distinct1 . TDC_TYP TDC_TYP, 
  1 C1, 
  Extent2 . TDC_NOM TDC_NOM, 
  Extent2 . TDC_TYP TDC_TYP1, 
  Extent2 . TDC_CLE TDC_CLE, 
  Extent2 . TDC_LANGREFSRC TDC_LANGREFSRC, 
  CASE WHEN Extent2 . TDC_NOM IS NULL THEN CAST(NULL AS INT) ELSE 1 END C2 
FROM (SELECT DISTINCT 
  Extent1 . TDC_TYP TDC_TYP 
FROM TRADDCT Extent1 ) Distinct1
LEFT OUTER JOIN TRADDCT Extent2
  ON (Distinct1 . TDC_TYP = Extent2 . TDC_TYP) OR ((Distinct1 . TDC_TYP IS NULL) AND (Extent2 . TDC_TYP IS NULL)) ) Project2  
ORDER BY Project2 . TDC_TYP, Project2 . C2 
