+        Get-Process fdhost,sqlservr -ErrorAction SilentlyContinue | Select-Object Name,Id,StartTime,Path | Format-Table -AutoSize
+        sc.exe query MSSQL`$DOCKERSQLEXPR
+        sc.exe query MSSQLFDLauncher`$DOCKERSQLEXPR
+        $q = @"
+        SET NOCOUNT ON;
+        SELECT 'SERVICE' AS Scope, FULLTEXTSERVICEPROPERTY('IsFullTextInstalled') AS IsFullTextInstalled, FULLTEXTSERVICEPROPERTY('LoadOSResources') AS LoadOSResources, FULLTEXTSERVICEPROPERTY('VerifySignature') AS VerifySignature;
+        SELECT 'CATALOG' AS Scope, FULLTEXTCATALOGPROPERTY(N'FullTextSmokeCatalog',N'PopulateStatus') AS CatalogPopulateStatus, OBJECTPROPERTYEX(OBJECT_ID(N'dbo.Documents'),N'TableFullTextPopulateStatus') AS TablePopulateStatus;
