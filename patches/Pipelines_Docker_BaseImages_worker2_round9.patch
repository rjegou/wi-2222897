+            if ($LASTEXITCODE -ne 0) { Write-Warning "SQL 2019 diagnostic exit=$LASTEXITCODE" }
+          } catch { Write-Warning ("SQL 2019 diagnostic collection failed: " + $_.Exception.Message) }
+          try { docker logs $container 2>&1 | Tee-Object "$(Build.ArtifactStagingDirectory)\sql-fulltext-2019-container.log" | Out-Host } catch { Write-Warning ("SQL 2019 container log collection failed: " + $_.Exception.Message) }
+          try {
+            docker rm -f $container 2>&1 | Out-Host
+            $removeCode = $LASTEXITCODE
+            $remaining = @(docker ps -a --filter "name=^$container`$" --format '{{.Names}}' 2>$null)
+            $inspectCode = $LASTEXITCODE
+            if ($inspectCode -ne 0) {
+              Write-Host "FULLTEXT_CLEANUP container=$container removeExit=$removeCode inspectExit=$inspectCode remaining=UNKNOWN"
+              Write-Warning 'SQL 2019 cleanup could not be verified: docker ps inspection failed'
+            } else {
+              Write-Host "FULLTEXT_CLEANUP container=$container removeExit=$removeCode inspectExit=$inspectCode remaining=$($remaining -join ',')"
+              if ($removeCode -ne 0 -or $remaining.Count -ne 0) { Write-Warning 'SQL 2019 cleanup could not be verified' }
+            }
+          } catch { Write-Warning ("SQL 2019 cleanup verification failed: " + $_.Exception.Message) }
         }
+        if ($null -ne $smokeError) { throw $smokeError }
       displayName: Build and smoke-test SQL Server 2019 Full-Text
     - publish: $(Build.ArtifactStagingDirectory)
       artifact: sql-fulltext-2019-evidence
