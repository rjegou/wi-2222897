+        SELECT * FROM sys.dm_fts_active_catalogs WHERE database_id = DB_ID();
+        SELECT * FROM sys.dm_fts_fdhosts;
+        SELECT * FROM sys.dm_fts_outstanding_batches WHERE database_id = DB_ID();
+        SELECT * FROM sys.dm_fts_population_ranges WHERE database_id = DB_ID();
