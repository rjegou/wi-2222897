diff --git a/Images/SqlExpress/tests.yml b/Images/SqlExpress/tests.yml
index 84a5d23..a5afdd7 100644
--- a/Images/SqlExpress/tests.yml
+++ b/Images/SqlExpress/tests.yml
@@ -129,3 +129,32 @@ steps:
       $data = sqlcmd -S "localhost\$env:sqlinstance" -U sa -P "$env:sa_password" -C -Q "SELECT GETDATE() AS TimeOfQuery"
       Write-Host $data
       if (!($data -Match "1 rows affected")) { Write-Host "[error]Query SELECT GETDATE() AS TimeOfQuery failed"; throw }
+
+# Full-Text is a prerequisite for the Clienteling search scenarios.  This is an
+# intentional functional gate: SQL Server 2019 standard Express media does not
+# include Full-Text, so the image selects Express with Advanced Services. SQL
+# Server 2025 Express includes the functionality formerly shipped as Express
+# with Advanced Services, but the downloaded bootstrap media is still checked by
+# this runtime assertion.
+- task: powershell@2
+  displayName: Check SQL Full-Text availability
+  inputs:
+    targetType: inline
+    script: |
+      $previousPreference = $ErrorActionPreference
+      $ErrorActionPreference = 'Continue'
+      $data = @(sqlcmd -S "localhost\$env:sqlinstance" -U sa -P "$env:sa_password" -C -h -1 -W -Q "SELECT FULLTEXTSERVICEPROPERTY('IsFullTextInstalled')" 2>&1)
+      $exitCode = $LASTEXITCODE
+      $ErrorActionPreference = $previousPreference
+      if ($exitCode -ne 0) {
+        Write-Host "[error]sqlcmd Full-Text probe failed (exit code $exitCode)"
+        $data | Select-Object -Last 5 | ForEach-Object { Write-Host $_ }
+        throw
+      }
+      $last = $data | Select-Object -Last 1
+      $value = if ($null -eq $last) { '' } else { ([string]$last).Trim() }
+      Write-Host "FULLTEXTSERVICEPROPERTY(IsFullTextInstalled)=$value"
+      if ([string]::IsNullOrWhiteSpace($value) -or $value -ne '1') {
+        Write-Host "[error]SQL Full-Text is not installed or enabled in this image"
+        throw
+      }
