+    Start-Process -Wait -FilePath "C:\tmp\downloader.exe" -ArgumentList "/ACTION=DOWNLOAD", "/Mediapath=C:/tmp", "/MediaType=Advanced", "/Quiet", "/language=en-US" > $NULL; \
